{
  "$id": "resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "mediaType",
    "size"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mediaType": {
      "type": "string",
      "maxLength": 200
    },
    "size": {
      "type": "integer",
      "minimum": 0
    }
  }
}

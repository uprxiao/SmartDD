{
  "scope": "real isolated Git repository; private index and hidden refs only; no product UI",
  "checks": {
    "headUnchanged": true,
    "userIndexByteIdentical": true,
    "stagedVersionPreserved": true,
    "beforeCapturedDirtyWorktree": true,
    "renameDetected": true,
    "deleteDetected": true,
    "binaryDetected": true,
    "hiddenRefsExist": true
  },
  "diff": [
    "A\tbinary.bin",
    "D\tdelete-me.txt",
    "R100\trename-me.txt\trenamed.txt",
    "M\ttracked.txt"
  ],
  "status": "passed",
  "cleanup": true
}

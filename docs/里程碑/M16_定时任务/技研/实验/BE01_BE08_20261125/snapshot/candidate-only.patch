+// F36 isolated candidate: window ownership separate from shell WebContents and trust.
+import type { BaseWindow, WebContents, WebContentsView } from 'electron';
+let mainWindow:BaseWindow|null=null, mainShell:WebContentsView|null=null;
+export function bindMainHost(window:BaseWindow,shell:WebContentsView):void{mainWindow=window;mainShell=shell;}
+export function clearMainHost(window:BaseWindow):boolean{if(mainWindow!==window)return false;mainWindow=null;mainShell=null;return true;}
+export function getMainWindow():BaseWindow|null{return mainWindow&&!mainWindow.isDestroyed()?mainWindow:null;}
+export function getMainShell():WebContentsView|null{return getMainWindow()&&mainShell&&!mainShell.webContents.isDestroyed()?mainShell:null;}
+export function getMainWindowContents():WebContents|null{return getMainShell()?.webContents??null;}
+export function mainWindowForContents(contents:WebContents):BaseWindow|null{return getMainWindowContents()===contents?getMainWindow():null;}

// Reuses the M4 CDP approach against our own Electron application.
// Each caller supplies a private userData directory. No global app state is edited.
import assert from 'node:assert/strict';
import { spawn } from 'node:child_process';
import { writeFile } from 'node:fs/promises';
import { createRequire } from 'node:module';
import { createServer } from 'node:net';
import { resolve } from 'node:path';

const require = createRequire(import.meta.url);
export const pause = (ms) => new Promise((r) => setTimeout(r, ms));

export async function openElectron({ userData, env: extraEnv = {}, executable, cwd = process.cwd(), inspectMain = false }) {
  const listener = createServer();
  await new Promise((r) => listener.listen(0, '127.0.0.1', r));
  const port = listener.address().port;
  await new Promise((r) => listener.close(r));
  const env = { ...process.env, SMARTDD_USER_DATA: userData, ...extraEnv };
  for (const name of Object.keys(env)) if (/^(ELECTRON_RUN_AS_NODE|ANTHROPIC_|OPENAI_|CLAUDECODE|CLAUDE_CODE_)/.test(name)) delete env[name];
  const child = spawn(executable ? resolve(executable) : require('electron'), [
    '--remote-debugging-address=127.0.0.1', `--remote-debugging-port=${port}`, ...(inspectMain ? ['--inspect=127.0.0.1:0'] : []), ...(executable ? [] : ['.']),
  ], { cwd, env, stdio: ['ignore', 'pipe', 'pipe'] });
  let logs = '';
  child.stdout.on('data', (b) => { logs += b; });
  child.stderr.on('data', (b) => { logs += b; });
  let ws;
  try {
    let page;
    const startupDeadline = Date.now() + 15_000;
    while (Date.now() < startupDeadline) {
      if (child.exitCode !== null || child.signalCode !== null) throw new Error('Electron exited before opening its test window');
      try { page = (await (await fetch(`http://127.0.0.1:${port}/json/list`, { signal: AbortSignal.timeout(Math.max(1, Math.min(1000, startupDeadline - Date.now()))) })).json()).find((p) => p.type === 'page'); } catch { /* starting; each request is bounded too */ }
      if (page) break;
      await pause(100);
    }
    assert(page, 'Electron debugging target not ready');
    ws = new WebSocket(page.webSocketDebuggerUrl);
    await new Promise((resolve, reject) => { ws.addEventListener('open', resolve, { once: true }); ws.addEventListener('error', reject, { once: true }); });
    let seq = 0;
    const pending = new Map();
    const cdpListeners = new Map();
    const rendererErrors = [];
    const navigationWaits = [];
    let targetCrashed = false;
    ws.addEventListener('message', ({ data }) => {
      const message = JSON.parse(data);
      if (message.id) {
        const request = pending.get(message.id);
        if (!request) return;
        clearTimeout(request.timer); pending.delete(message.id);
        message.error ? request.reject(Object.assign(new Error(message.error.message), {
          cdpMethod: request.method, cdpCode: message.error.code,
        })) : request.resolve(message.result);
      }
      if (message.method === 'Inspector.targetCrashed') targetCrashed = true;
      if (message.method === 'Runtime.exceptionThrown') rendererErrors.push(message.params.exceptionDetails.text);
      for (const listener of cdpListeners.get(message.method) ?? []) listener(message.params);
    });
    const cdp = (method, params = {}, timeoutMs = 25_000) => new Promise((resolve, reject) => {
      const id = ++seq;
      const timer = setTimeout(() => { pending.delete(id); reject(new Error(`Electron ${method} timed out`)); }, timeoutMs);
      pending.set(id, { resolve, reject, timer, method }); ws.send(JSON.stringify({ id, method, params }));
    });
    await cdp('Runtime.enable');
    await cdp('Inspector.enable');
    const evaluate = async (expression, timeoutMs) => {
      const result = await cdp('Runtime.evaluate', { expression, awaitPromise: true, returnByValue: true }, timeoutMs);
      if (result.exceptionDetails) throw new Error(result.exceptionDetails.exception?.description ?? result.exceptionDetails.text);
      return result.result.value;
    };
    // Navigation retries are opt-in for read-only DOM conditions. Never replay
    // inputs, invoke calls or arbitrary evaluate expressions after navigation.
    const waitFor = async (expression, ms = 10_000, { navigation = false } = {}) => {
      const deadline = Date.now() + ms;
      const alive = () => child.exitCode === null && child.signalCode === null && ws.readyState === WebSocket.OPEN && !targetCrashed;
      while (Date.now() < deadline) {
        if (!alive()) throw new Error('Isolated Electron target stopped during condition wait');
        try { if (await evaluate(expression, Math.max(1, deadline - Date.now()))) return; }
        catch (error) {
          const contextChanged = error.cdpMethod === 'Runtime.evaluate' && /^(Inspected target navigated or closed|Execution context was destroyed.*|Cannot find context with specified id.*)$/.test(error.message);
          if (!navigation || !contextChanged || !alive() || Date.now() >= deadline) throw error;
          // Confirm the original page still belongs to our original process/port.
          // A closed/crashed/replaced target is a failure, never a reattachment.
          let targets;
          try {
            targets = await (await fetch(`http://127.0.0.1:${port}/json/list`, {
              signal: AbortSignal.timeout(Math.max(1, Math.min(1000, deadline - Date.now()))),
            })).json();
          } catch { throw error; }
          if (!alive() || !targets.some(target => target.id === page.id && target.type === 'page' && target.webSocketDebuggerUrl === page.webSocketDebuggerUrl)) throw error;
          navigationWaits.push({ at: new Date().toISOString(), pageId: page.id, code: error.cdpCode, message: error.message });
        }
        if (Date.now() < deadline) await pause(Math.min(100, deadline - Date.now()));
      }
      // Expressions may contain test parameters; never echo them on failure.
      throw new Error('Electron test condition timed out');
    };
    await waitFor('Boolean(window.electronAPI && document.querySelector("[data-testid=nav-settings]"))', 10_000, { navigation: true });
    await evaluate(`window.__m5 = { output: {}, exits: {} };
      window.electronAPI.eventOn('pty:data', e => { window.__m5.output[e.ptyId] = (window.__m5.output[e.ptyId] || '') + e.data; });
      window.electronAPI.eventOn('pty:exit', e => { window.__m5.exits[e.ptyId] = e.code; }); true`);
    const invoke = (channel, ...args) => evaluate(`window.electronAPI.invoke(${JSON.stringify(channel)}, ...${JSON.stringify(args)})`, 70_000);
    // Test-only main-process evaluation. Enabled solely by the local launch flag above.
    // Used to compare decrypted credentials with artifacts without returning the credentials.
    const mainEvaluate = async (expression) => {
      assert(inspectMain, 'Main inspection was not enabled for this test instance');
      const url = /Debugger listening on (ws:\/\/127\.0\.0\.1:[^\s]+)/.exec(logs)?.[1];
      assert(url, 'Main inspector unavailable');
      const socket = new WebSocket(url);
      await new Promise((resolve, reject) => { socket.addEventListener('open', resolve, { once: true }); socket.addEventListener('error', reject, { once: true }); });
      try {
        return await new Promise((resolve, reject) => {
          const timer = setTimeout(() => reject(new Error('Main inspection timed out')), 25_000);
          socket.addEventListener('message', ({ data }) => {
            const m = JSON.parse(data); if (m.id !== 1) return; clearTimeout(timer);
            if (m.error || m.result.exceptionDetails) reject(new Error('Credential audit could not complete inside the main process'));
            else resolve(m.result.result.value);
          });
          socket.send(JSON.stringify({ id: 1, method: 'Runtime.evaluate', params: { expression, awaitPromise: true, returnByValue: true } }));
        });
      } finally { socket.close(); }
    };
    return {
      cdp, evaluate, mainEvaluate, waitFor, invoke, rendererErrors, navigationWaits,
      onCDP: (method, listener) => {
        const listeners = cdpListeners.get(method) ?? new Set();
        listeners.add(listener); cdpListeners.set(method, listeners);
        return () => { listeners.delete(listener); if (!listeners.size) cdpListeners.delete(method); };
      },
      processId: child.pid,
      waitForExit: (timeoutMs = 15_000) => new Promise((resolve, reject) => {
        const result = () => ({ pid: child.pid, code: child.exitCode, signal: child.signalCode });
        if (child.exitCode !== null || child.signalCode !== null) { resolve(result()); return; }
        const onExit = () => { clearTimeout(timer); resolve(result()); };
        const timer = setTimeout(() => { child.off('exit', onExit); reject(new Error('Isolated App did not finish its normal exit')); }, timeoutMs);
        child.once('exit', onExit);
      }),
      crash: async () => {
        assert(child.exitCode === null && child.signalCode === null, 'Test App is already stopped');
        const exited = new Promise(resolve => child.once('exit', (code, signal) => resolve({ pid: child.pid, code, signal })));
        assert(child.kill('SIGKILL'), 'Could not stop this isolated test App');
        return await Promise.race([exited, pause(3000).then(() => { throw new Error('Test App crash did not finish'); })]);
      },
      output: (ptyId) => evaluate(`window.__m5.output[${JSON.stringify(ptyId)}] || ''`),
      input: (ptyId, data) => evaluate(`window.electronAPI.eventSend('pty:input', ${JSON.stringify({ ptyId, data })})`),
      screenshot: async (path) => { const { data } = await cdp('Page.captureScreenshot', { format: 'png' }); await writeFile(path, Buffer.from(data, 'base64'), { mode: 0o600 }); },
      logs: () => logs,
      close: async () => {
        for (const item of pending.values()) { clearTimeout(item.timer); item.reject(new Error('Electron test closed')); }
        pending.clear(); ws.close();
        cdpListeners.clear();
        if (child.exitCode === null && child.signalCode === null) {
          const done = new Promise((r) => child.once('exit', r));
          child.kill('SIGTERM');
          await Promise.race([done, pause(3000)]);
          if (child.exitCode === null && child.signalCode === null) child.kill('SIGKILL');
        }
      },
    };
  } catch (error) { ws?.close(); child.kill('SIGKILL'); throw error; }
}

 const health=await poll(async()=>{const p=await app.invoke('aiProfiles.get',profile.id);return !p.checking&&p.check?p:null;},45000);result.health=health.check;assert.equal(health.check.status,'ok');
 stage='initial-cli';await progress();const first=await app.invoke('tasks.create',{projectId:project.id,dirId:null,aiProfileId:profile.id,firstMessage:marker+'_INITIAL: Return a brief response only. Do not use tools or perform any action.',cols:120,rows:35});task=first.task;result.taskId=task.id;await complete('INITIAL');const initial=await app.invoke('applications.session',task.id);assert(initial.ok);assert.equal(initial.value.currentRun.bridge.connected,true);result.initial=initial.value;result.initialTask=task;checked('Real native Codex created a bound session and completed a turn through the packaged host');
 await stop();const before=dbRead();result.beforeFault=before;assert.equal(task.recovery,'resumable');const fixed=JSON.parse(before.snapshot.snapshot_json),hash=fixed.packages.find(x=>x.appId==='mail').packageHash,pack=before.packages.find(x=>x.package_hash===hash),target=join(userData,'capabilities',pack.relative_path);assert(target.startsWith(join(userData,'capabilities/apps/')));result.originalTree=await tree(target);result.originalPackageHash=hash;
 await rm(target,{recursive:true});result.fault={at:new Date().toISOString(),target,boundary:'Offline to this stopped Task: remove only owned C package directory after all its consumers exited; trusted packaged distribution remains present. This is not a no-trusted-copy scenario.'};
 stage='unavailable-cli';await progress();task=(await app.invoke('tasks.open',{taskId:task.id,cols:120,rows:35})).task;assert.equal(task.nativeSessionId,before.task.native_session_id);const unavailable=await app.invoke('applications.session',task.id);assert(unavailable.ok);result.unavailable=unavailable.value;assert.equal(unavailable.value.snapshotHash,before.snapshot.snapshot_hash);assert.equal(unavailable.value.currentRun.restriction.reason,'fixed_application_resources_unavailable');assert.equal(unavailable.value.currentRun.bridge.connected,false);assert(task.runtimeSnapshot.selfCheck.issues.includes('CAPABILITY_UNAVAILABLE'));
 await poll(async()=>(await protocol()).includes(marker+'_INITIAL_DONE'),30000);await writePty(marker+'_UNAVAILABLE: Reply briefly. Do not use tools or perform any action.');await poll(async()=>(await protocol()).includes(marker+'_UNAVAILABLE'),5000);await writePty('\r');await complete('UNAVAILABLE');const unavailableRequests=result.requests.filter(x=>x.kind==='task'&&x.phase==='unavailable-cli');assert(unavailableRequests.length);assert(unavailableRequests.every(x=>!x.toolNames.some(n=>n.includes('smartdd_mail_'))));const during=dbRead();assert.deepEqual(during.snapshot,before.snapshot);assert.deepEqual(during.identity,before.identity);assert.deepEqual(during.refs,before.refs);assert.equal(during.invocation.length,0);assert.equal(during.grantCount,0);checked('Same native session actually completes another turn with missing original package, unchanged fixed S/refs/identity and no application bridge or calls');
 await stop();await close();stage='repaired-startup';await start();assert.equal((await app.invoke('agentSupport.status')).state,'ready');const repaired=dbRead();assert.deepEqual(repaired.packages,before.packages);assert.deepEqual(repaired.defaults,before.defaults);assert.deepEqual(repaired.proofs,before.proofs);assert.deepEqual(await tree(target),result.originalTree);assert.equal(repaired.resources.find(x=>x.resource_id===pack.resource_id).generation,before.resources.find(x=>x.resource_id===pack.resource_id).generation+1);assert.equal(repaired.restoration.length,1);assert.equal(repaired.restoration[0].state,'committed');result.repairedStartup=repaired;checked('Real packaged startup restores exact original bytes/modes from trusted same-hash distribution without changing default or fixed metadata');
 stage='repaired-cli';await progress();task=(await app.invoke('tasks.open',{taskId:task.id,cols:120,rows:35})).task;assert.equal(task.nativeSessionId,before.task.native_session_id);await poll(async()=>{const x=await app.invoke('applications.session',task.id);return x.ok&&x.value.currentRun?.bridge.connected;},30000);await poll(async()=>(await protocol()).includes(marker+'_UNAVAILABLE_DONE'),30000);await writePty(marker+'_REPAIRED: Read the local project draft list using the mail draft-list tool. Do not change or send anything.');await poll(async()=>(await protocol()).includes(marker+'_REPAIRED'),5000);await writePty('\r');await complete('REPAIRED');assert.equal(result.restoredToolOutputs?.length,1);const finalDiagnostic=await app.invoke('applications.session',task.id);assert(finalDiagnostic.ok);result.finalDiagnostic=finalDiagnostic.value;assert.equal(finalDiagnostic.value.snapshotHash,before.snapshot.snapshot_hash);assert(finalDiagnostic.value.applications.find(x=>x.packageHash===hash).evidence.successfulToolRequests>=1);checked('Original native session resumes again and actually executes one local read through its restored fixed application MCP bridge');

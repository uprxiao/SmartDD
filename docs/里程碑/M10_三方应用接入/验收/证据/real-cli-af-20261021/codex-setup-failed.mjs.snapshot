 if(isTask&&phase==='REPAIRED'&&!result.issuedTool){const ns=(body.tools??[]).find(t=>t.type==='namespace'&&(t.tools??[]).some(x=>x.name==='smartdd_mail_draft_list_v1'));assert(ns,'Restored native request lacks original mail draft-list tool');const call={type:'function_call',id:'fc_af_restored_draft_list',call_id:'call_af_restored_draft_list',name:'smartdd_mail_draft_list_v1',namespace:ns.name,arguments:'{}',status:'completed'};result.issuedTool={...call,fixture:'synthetic provider selects one local read;not autonomous real-model discovery'};send('response.created',{response:{id:'resp_af_tool',object:'response',created_at:Math.floor(Date.now()/1000),status:'in_progress',output:[]}});send('response.output_item.added',{output_index:0,item:{...call,status:'in_progress',arguments:''}});send('response.function_call_arguments.delta',{item_id:call.id,output_index:0,delta:call.arguments});send('response.function_call_arguments.done',{item_id:call.id,output_index:0,arguments:call.arguments});send('response.output_item.done',{output_index:0,item:call});send('response.completed',{response:{id:'resp_af_tool',object:'response',created_at:Math.floor(Date.now()/1000),status:'completed',model:body.model,output:[call],usage:{input_tokens:1,output_tokens:1,total_tokens:2}}});res.end();return;}
 const id='msg_af_'+result.requests.length,item={id,type:'message',role:'assistant',status:'completed',content:[{type:'output_text',text,annotations:[]}]};send('response.created',{response:{id:'resp_'+id,object:'response',created_at:Math.floor(Date.now()/1000),status:'in_progress',output:[]}});send('response.output_item.added',{output_index:0,item:{...item,status:'in_progress',content:[]}});send('response.content_part.added',{item_id:id,output_index:0,content_index:0,part:{type:'output_text',text:'',annotations:[]}});send('response.output_text.delta',{item_id:id,output_index:0,content_index:0,delta:text});send('response.output_text.done',{item_id:id,output_index:0,content_index:0,text});send('response.content_part.done',{item_id:id,output_index:0,content_index:0,part:item.content[0]});send('response.output_item.done',{output_index:0,item});send('response.completed',{response:{id:'resp_'+id,object:'response',created_at:Math.floor(Date.now()/1000),status:'completed',model:body.model,output:[item],usage:{input_tokens:1,output_tokens:1,total_tokens:2,input_tokens_details:{cached_tokens:0},output_tokens_details:{reasoning_tokens:0}}}});res.end();
 }catch(error){result.providerError=String(error);if(!res.headersSent)res.writeHead(500);res.end();}});});server.on('connection',s=>{sockets.add(s);s.on('error',()=>{});s.on('close',()=>sockets.delete(s));});await new Promise(r=>server.listen(0,'127.0.0.1',r));const port=server.address().port;
const config='model="m10-af-model"\nmodel_provider="m10_af_fixture"\nnotify=[]\n[model_providers.m10_af_fixture]\nname="M10 AF local synthetic"\nbase_url="http://127.0.0.1:'+port+'/v1"\nwire_api="responses"\nrequires_openai_auth=false\n[analytics]\nenabled=false\n[feedback]\nenabled=false\n[projects.'+JSON.stringify(cwd)+']\ntrust_level="trusted"\n';await writeFile(join(state,'config.toml'),config);
const privateEnv={HOME:home,ZDOTDIR:home,CODEX_HOME:state,HTTP_PROXY:'http://127.0.0.1:1',HTTPS_PROXY:'http://127.0.0.1:1',ALL_PROXY:'http://127.0.0.1:1',NO_PROXY:'127.0.0.1,localhost',SHELL:'/bin/zsh',TERM:'xterm-256color'};
async function poll(fn,ms=30000){const end=Date.now()+ms;do{const value=await fn();if(value)return value;await new Promise(r=>setTimeout(r,100));}while(Date.now()<end);throw Error('Bounded wait failed at '+stage);}
const dbRead=()=>JSON.parse(execFileSync(executable,[join(evidence,'db-read.cjs'),join(userData,'smartdd.db'),task.id],{encoding:'utf8',env:{PATH:'/usr/bin:/bin',ELECTRON_RUN_AS_NODE:'1'},timeout:10000,maxBuffer:12*1024*1024}));
async function tree(dir,base=dir){let a=[];for(const ent of await readdir(dir,{withFileTypes:true})){const p=join(dir,ent.name),s=await lstat(p);assert(!s.isSymbolicLink());if(s.isDirectory())a.push(...await tree(p,base));else{assert(s.isFile());a.push({path:relative(base,p),mode:s.mode&0o777,sha256:sha(await readFile(p))});}}return a.sort((x,y)=>x.path.localeCompare(y.path));}
async function start(){await progress();app=await openElectron({executable,userData,cwd,env:privateEnv,inspectMain:true});const round={pid:app.processId,at:new Date().toISOString(),stage};result.rounds.push(round);round.hidden=await app.mainEvaluate(`(()=>{const{BrowserWindow}=process.getBuiltinModule('node:module').createRequire(process.execPath)('electron');for(const w of BrowserWindow.getAllWindows())w.hide();return BrowserWindow.getAllWindows().map(w=>({visible:w.isVisible(),focused:w.isFocused(),webFocused:w.webContents.isFocused()}));})()`);await app.evaluate(`document.title='I · M10 · real CLI recovery · isolated hidden window';true`);}
async function close(){if(app){const current=app;app=undefined;await writeFile(join(root,stage+'-electron.txt'),current.logs());await current.close();}}
async function writePty(data){assert(task?.ptyId);await app.evaluate(`window.electronAPI.eventSend('pty:input',${JSON.stringify({taskId:task.id,ptyId:task.ptyId,data})});true`);}
async function protocol(){const output=await app.output(task.ptyId);const observed=result.terminalProtocolResponses.filter(x=>x.ptyId===task.ptyId);for(const[query,reply,name]of[['\x1b[6n','\x1b[1;1R','cursor-position'],['\x1b]11;?','\x1b]11;rgb:0000/0000/0000\x07','background-color'],['\x1b]10;?','\x1b]10;rgb:ffff/ffff/ffff\x07','foreground-color']]){const n=output.split(query).length-1,sent=observed.filter(x=>x.name===name).length;if(n>sent&&sent<10){await writePty(reply);result.terminalProtocolResponses.push({ptyId:task.ptyId,name,at:new Date().toISOString(),boundary:'minimal terminal protocol responder;no visible UI geometry or keyboard acceptance claim'});}}return output;}
async function nativeRows(){const files=[];async function scan(dir){for(const x of await readdir(dir,{withFileTypes:true}).catch(()=>[])){const p=join(dir,x.name);if(x.isDirectory())await scan(p);else if(x.name.endsWith('.jsonl'))files.push(p);}}await scan(join(state,'sessions'));const rows=[];for(const file of files){for(const line of(await readFile(file,'utf8')).split('\n'))try{rows.push({file,value:JSON.parse(line)});}catch{}}return rows;}
async function complete(phase){const endMarker=marker+'_'+phase+'_DONE';await poll(async()=>{const out=await protocol();await writeFile(join(root,stage+'-terminal.txt'),out);task=await app.invoke('tasks.get',task.id);const rows=await nativeRows();return task.nativeSessionId&&out.includes(endMarker)&&rows.some(x=>x.value.type==='event_msg'&&x.value.payload?.type==='task_complete'&&x.value.payload.last_agent_message?.includes(endMarker));},45000);}
async function stop(){if(!task)return;await app.invoke('tasks.kill',task.id);await poll(async()=>{task=await app.invoke('tasks.get',task.id);const d=dbRead();return !task.ptyId&&d.runs.every(r=>r.state==='stopped')&&d.children.every(p=>['exited','canceled'].includes(p.state))&&d.leases.every(l=>l.state==='released');},15000);}
try{
 await start();stage='prerequisites';await progress();assert.equal((await app.invoke('agentSupport.status')).state,'ready');project=await app.invoke('projects.create',{name:'M10 real CLI private integration',aliases:[],description:'Local synthetic only;not UI acceptance',rulesPath:null},[{label:'private',path:cwd}]);result.projectId=project.id;
 const catalog=await app.invoke('applications.catalog');assert(catalog.ok);const mail=catalog.value.find(x=>x.appId==='mail');assert((await app.invoke('applications.setAdded','mail',true,mail.revision)).ok);assert((await app.invoke('applications.select',{projectId:project.id,appId:'mail',enabled:true,expectedRevision:0,connections:{foxmail:null,smtp:null}})).ok);

 if(!req.url?.endsWith('/responses')){res.writeHead(404);res.end('{}');return;}const body=JSON.parse(Buffer.concat(chunks)),raw=JSON.stringify(body),health=raw.match(/SMARTDD-OK-[0-9a-f]{8}/)?.[0],isTask=raw.includes(marker),phase=stage.startsWith('repaired')?'REPAIRED':stage.startsWith('unavailable')?'UNAVAILABLE':'INITIAL',text=isTask?marker+'_'+phase+'_DONE':health??'M10_AF_HEALTH_OK';
 const toolNames=(body.tools??[]).flatMap(t=>t.type==='namespace'?(t.tools??[]).map(x=>t.name+'.'+x.name):[t.name??t.type]);const observation={at:new Date().toISOString(),phase:stage,kind:isTask?'task':'health',requestBytes:bytes,sha256:sha(raw),model:body.model,toolNames,response:text};result.requests.push(observation);console.log(JSON.stringify({request:observation.kind,phase,toolCount:toolNames.length}));

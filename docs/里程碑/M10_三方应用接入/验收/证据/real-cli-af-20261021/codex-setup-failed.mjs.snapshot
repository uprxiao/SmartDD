}catch(error){result.status='failed';result.failedStage=stage;result.error=String(error);result.stack=error.stack;process.exitCode=1;if(app&&task){result.observedTask=await app.invoke('tasks.get',task.id).catch(()=>null);await writeFile(join(root,'failure-terminal.txt'),task.ptyId?await app.output(task.ptyId).catch(()=>''):'');try{result.failureDb=dbRead();}catch(e){result.failureDbError=String(e);}}}
finally{if(app&&task)try{await stop();}catch(error){result.cleanupStopError=String(error);}await close();for(const s of sockets)s.destroy();await new Promise(r=>server.close(r));result.cleanup='Only own Task/App/listener stopped;harness close is cleanup,not normal-quit acceptance';result.knownHostPidsAbsent=result.rounds.every(x=>{try{process.kill(x.pid,0);return false;}catch(e){return e.code==='ESRCH';}});result.finishedAt=new Date().toISOString();await writeFile(join(root,'result.json'),JSON.stringify(result,null,2)+'\n');await writeFile(join(evidence,'result-path.txt'),join(root,'result.json')+'\n');console.log(JSON.stringify({root,status:result.status,stage,checks:result.checks.length,error:result.error,result:join(root,'result.json')}));}

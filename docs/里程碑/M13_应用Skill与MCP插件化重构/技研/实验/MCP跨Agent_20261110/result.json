 "conv_codex_to_claude_field": {
  "mcpServers": {
   "wystdio": {
    "type": "stdio",
    "command": "node",
    "args": [
     "/tmp/m13-mcp-driver/fake-mcp-stdio.mjs",
     "<root>/mcp-calls.log"
    ],
    "env": {
     "WY_STATIC": "static-val",
     "WY_PASS": "${WY_PASS}"
    },
    "cwd": "<root>/server-cwd"
   },
   "wyhttp": {
    "type": "http",
    "url": "http://127.0.0.1:53266/mcp",
    "headers": {
     "Authorization": "Bearer ${WY_HTTP_TOKEN}"
    }
   }
  },
  "notes": [
   "wystdio: startup_timeout_sec 无逐服务器对应",
   "wystdio: tool_timeout_sec 无逐服务器对应",
   "wyoff: enabled=false 跳过"
  ]
 },

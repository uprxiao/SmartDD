{
 "claude": {
  "args": [
   "claude",
   "--permission-mode",
   "default"
  ],
  "cycle": [
   {
    "after": "Shift+Tab #1",
    "modes": [
     "accept edits on"
    ]
   },
   {
    "after": "Shift+Tab #2",
    "modes": [
     "plan mode on"
    ]
   },
   {
    "after": "Shift+Tab #3",
    "modes": [
     "auto mode on"
    ]
   },
   {
    "after": "Shift+Tab #4",
    "modes": [
     "manual mode on"
    ]
   },
   {
    "after": "Shift+Tab #5",
    "modes": [
     "accept edits on"
    ]
   },
   {
    "after": "Shift+Tab #6",
    "modes": [
     "plan mode on"
    ]
   }
  ]
 },
 "claude-allow-bypass": {
  "args": [
   "claude",
   "--permission-mode",
   "default",
   "--allow-dangerously-skip-permissions"
  ],
  "cycle": [
   {
    "after": "Shift+Tab #1",
    "modes": []
   },
   {
    "after": "Shift+Tab #2",
    "modes": []
   },
   {
    "after": "Shift+Tab #3",
    "modes": []
   },
   {
    "after": "Shift+Tab #4",
    "modes": []
   },
   {
    "after": "Shift+Tab #5",
    "modes": []
   },
   {
    "after": "Shift+Tab #6",
    "modes": []
   }
  ]
 },
 "codex": {
  "snaps": [
   {
    "after": "trust Enter",
    "text": "\r\nUpdating Codex via `npm install -g @openai/codex`...\r\n\\|/-\\|/-\\|/-\\|/-\\"
   },
   {
    "after": "type /permissions",
    "text": "/permissions|/-\\|/-\\|/"
   },
   {
    "after": "Enter",
    "text": "\r\n-\\|/-\\|/-\\|/-\\|/-\\|/"
   },
   {
    "after": "Esc",
    "text": "^[-\\|/-\\|"
   }
  ],
  "globalUnchanged": true
 }
}
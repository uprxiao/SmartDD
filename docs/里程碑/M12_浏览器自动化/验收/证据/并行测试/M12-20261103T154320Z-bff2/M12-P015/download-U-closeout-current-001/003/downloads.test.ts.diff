+  it('removing a completed record preserves the actual downloaded file bytes',async()=>{const directory=await mkdtemp(join(tmpdir(),'willyou-m12-download-record-')),f=fixture(directory);try{const {item}=f.start();await writeFile(item.path,'synthetic downloaded bytes');item.emit('done',{},'completed');const id=f.manager.snapshot('t1')[0].id;await f.manager.action('t1',id,'open');expect(shell.openPath).toHaveBeenLastCalledWith(item.path);await f.manager.action('t1',id,'reveal');expect(shell.showItemInFolder).toHaveBeenLastCalledWith(item.path);await f.manager.action('t1',id,'remove');expect(await readFile(item.path,'utf8')).toBe('synthetic downloaded bytes');}finally{f.manager.dispose();await rm(directory,{recursive:true,force:true});}});
   it('applies an explicit path only after dispatch and only to the next download from that page',async()=>{const f=fixture();try{const pending=f.manager.expect(f.contents,'/private/project-external/exact.json',new AbortController().signal),before=f.start();expect(pending.claimed()).toBe(false);expect(before.item.path).toContain('/private/synthetic/Downloads/');pending.start();const target=f.start();expect(pending.claimed()).toBe(true);expect(target.item.path).toBe('/private/project-external/exact.json');expect(f.manager.snapshot('t1')[0].destination).toBe('explicit');const later=f.start();expect(later.item.path).toContain('/private/synthetic/Downloads/');target.item.bytes=100;target.item.emit('done',{},'completed');expect(await pending.result).toMatchObject({path:'/private/project-external/exact.json',receivedBytes:100});}finally{f.manager.dispose();}});
   it('aborts only the claimed native item and clears a waiting override without retrying the click',async()=>{const f=fixture();try{const controller=new AbortController(),pending=f.manager.expect(f.contents,'/private/explicit-one.csv',controller.signal);pending.start();const target=f.start();controller.abort(new Error('cancel expected'));await expect(pending.result).rejects.toThrow('cancel expected');expect(target.item.cancel).toHaveBeenCalledOnce();const ordinary=f.start();expect(ordinary.item.path).toContain('/private/synthetic/Downloads/');expect(ordinary.item.cancel).not.toHaveBeenCalled();const second=f.manager.expect(f.contents,'/private/explicit-two.csv',new AbortController().signal);second.cancel(new Error('click rejected before dispatch'));await expect(second.result).rejects.toThrow('click rejected');expect(f.start().item.path).toContain('/private/synthetic/Downloads/');}finally{f.manager.dispose();}});
   it('rejects pending downloads on page destruction, unavailable profiles and shutdown',async()=>{const f=fixture();try{const first=f.manager.expect(f.contents,'/private/first.csv',new AbortController().signal);first.start();f.setAvailable(false);expect(f.start().event.preventDefault).toHaveBeenCalledOnce();await expect(first.result).rejects.toThrow('不可用');f.setAvailable(true);const second=f.manager.expect(f.contents,'/private/second.csv',new AbortController().signal);f.contents.emit('destroyed');await expect(second.result).rejects.toThrow('网页已关闭');}finally{f.manager.dispose();}const other=fixture(),pending=other.manager.expect(other.contents,'/private/final.csv',new AbortController().signal);other.manager.dispose();await expect(pending.result).rejects.toThrow('服务已关闭');});

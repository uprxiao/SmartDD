   it('cancels a live item and reports interrupted terminal state without a completed file action',async()=>{const f=fixture();try{const {item}=f.start(),id=f.manager.snapshot('t1')[0].id;await f.manager.action('t1',id,'cancel');expect(item.cancel).toHaveBeenCalledOnce();expect(f.manager.snapshot('t1')[0].state).toBe('cancelled');const second=f.start();second.item.emit('done',{},'interrupted');const failed=f.manager.snapshot('t1')[0];expect(failed.state).toBe('failed');await expect(f.manager.action('t1',failed.id,'open')).rejects.toThrow('尚未完成');}finally{f.manager.dispose();}});
   it('denies unavailable/foreign owners and does not leak a filename reservation after native save setup fails',()=>{const f=fixture();try{f.setAvailable(false);expect(f.start().event.preventDefault).toHaveBeenCalledOnce();expect(f.manager.snapshot('t1')).toHaveLength(0);f.setAvailable(true);const foreign=Object.assign(new EventEmitter(),{session:f.session,isDestroyed:()=>false}) as unknown as WebContents;expect(f.start(new Item(),foreign).event.preventDefault).toHaveBeenCalledOnce();const item=new Item();item.failSave=true;expect(f.start(item).event.preventDefault).toHaveBeenCalledOnce();expect(f.manager.snapshot('t1')[0].state).toBe('failed');expect(f.start().item.path).toBe('/private/synthetic/Downloads/订单导出.csv');}finally{f.manager.dispose();}});

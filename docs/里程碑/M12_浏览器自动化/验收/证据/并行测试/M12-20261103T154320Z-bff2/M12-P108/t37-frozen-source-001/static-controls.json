        "value": "async () => {\n        closeMainInspection();\n        for (const item of pending.values()) {\n          clearTimeout(item.timer);\n          item.reject(new Error(\"Electron test closed\"));\n        }\n        pending.clear();\n        ws.close();\n        cdpListeners.clear();\n        if (child.exitCode === null && child.signalCode === null) {\n          const done = new Promise((r) => child.once(\"exit\", r));\n          observed.signals.push({atMs:Date.now(),method:\"close\",signal:\"SIGTERM\",accepted:child.kill(\"SIGTERM\")});\n          await Promise.race([done, pause(3000)]);\n          if (child.exitCode === null && child.signalCode === null)\n            observed.signals.push({atMs:Date.now(),method:\"close\",signal:\"SIGKILL\",accepted:child.kill(\"SIGKILL\")});\n        }\n      }"

+// Literal values must stay JavaScript data, never be interpolated inside a
+// quoted CSS selector. Apostrophes/quotes/Unicode are ordinary attribute text.
+fn literal_attribute_query(selector: &str, attribute: &str, value: &str) -> String {
+    format!(
+        r#"(() => {{
+        const el = Array.from(document.querySelectorAll({selector}))
+            .find(el => el.getAttribute({attribute}) === {value});
+        if (el) {{ el.setAttribute('data-agent-browser-located', 'true'); return true; }}
+        return false;
+    }})()"#,
+        selector = serde_json::to_string(selector).unwrap_or_default(),
+        attribute = serde_json::to_string(attribute).unwrap_or_default(),
+        value = serde_json::to_string(value).unwrap_or_default()
+    )
+}

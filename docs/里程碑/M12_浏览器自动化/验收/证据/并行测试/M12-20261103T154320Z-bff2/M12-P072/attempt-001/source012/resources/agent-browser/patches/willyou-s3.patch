+fn track_mouse_click(state: &mut MouseState, button_mask: i32, at: std::time::Instant) -> i32 {
+    let repeated = state.last_click.is_some_and(|last| {
+        last.button_mask == button_mask
+            && (last.x - state.x).abs() <= 2.0
+            && (last.y - state.y).abs() <= 2.0
+            && at.saturating_duration_since(last.at) <= std::time::Duration::from_millis(500)
+    });
+    let count = if repeated {
+        state
+            .last_click
+            .map_or(1, |last| if last.count >= 3 { 1 } else { last.count + 1 })
+    } else {
+        1
+    };
+    state.last_click = Some(LastMouseClick {
+        button_mask,
+        x: state.x,
+        y: state.y,
+        at,
+        count,
+    });
+    count
+}

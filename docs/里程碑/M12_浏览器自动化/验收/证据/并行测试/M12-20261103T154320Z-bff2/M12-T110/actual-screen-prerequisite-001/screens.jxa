ObjC.import('AppKit'); var s=$.NSScreen.screens; var a=[]; for(var i=0;i<Number(s.count);i++){var x=s.objectAtIndex(i),f=x.frame,v=x.visibleFrame; a.push({index:i,frame:{x:Number(f.origin.x),y:Number(f.origin.y),width:Number(f.size.width),height:Number(f.size.height)},visibleFrame:{x:Number(v.origin.x),y:Number(v.origin.y),width:Number(v.size.width),height:Number(v.size.height)},scale:Number(x.backingScaleFactor)});} JSON.stringify({screenCount:a.length,screens:a,scope:'Screen count and geometry only; no screenshot/window inventory/content/serial/device identifiers'});

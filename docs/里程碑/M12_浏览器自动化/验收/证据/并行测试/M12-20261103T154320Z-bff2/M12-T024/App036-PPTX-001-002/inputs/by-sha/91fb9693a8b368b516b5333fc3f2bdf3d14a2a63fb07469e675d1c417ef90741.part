 const trace=()=>observeFileMethods({mainEvaluate:expression=>own('return ('+expression+');','readonly-t024-pptx-model-rows')});const model=async()=>{const rr=await trace(),o=rr.findLast(x=>x.method==='openPptx'&&x.delivered);assert(o);return[o.output.state,...rr.filter(x=>x.delivered&&x.args[0]?.id===o.output.id&&['editPptx','savePptx'].includes(x.method)).map(x=>x.output.state??x.output)].reduce((a,b)=>b.version>=a.version?b:a)};const order=x=>x.info.slides[0].elements.map(e=>e.id);r.beforeModel=await model();assert.deepEqual(order(r.beforeModel),['201','202','203','204']);r.browserBefore=await app.invoke('browser.snapshot',{taskId:r.taskId});

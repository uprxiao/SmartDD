 stage='save-own-fixture-for-clean-exit';await ui.click('.fw-office-page-status');for(const type of['keyDown','keyUp'])await app.cdp('Input.dispatchKeyEvent',{type,key:'s',code:'KeyS',windowsVirtualKeyCode:83,modifiers:4});r.savedModel=await poll(async()=>{const m=await model();return !m.dirty?m:null},90000);r.fixtureSavedSHA256=sha(await readFile(file));r.checks.push({id:'physical-Pages-PPTX-layer-owner-no-browser-tab',beforeOrder:order(r.beforeModel),afterOrder:order(r.afterModel),savedOrder:order(r.savedModel),browserBefore:r.browserBefore,browserAfter:r.browserAfter,physicalKey:r.physicalKey});r.status='executed-unjudged';

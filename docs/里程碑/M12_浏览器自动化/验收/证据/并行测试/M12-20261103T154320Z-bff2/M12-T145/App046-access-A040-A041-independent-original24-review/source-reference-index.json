      },
      {
        "line": 12,
        "text": "    <div ref={ref} role=\"dialog\" aria-modal=\"true\" aria-label={title} className={'fw-dialog bw-dialog' + (wide ? ' bw-dialog-wide' : '')} onKeyDown={event => { if (event.key === 'Escape') { event.stopPropagation(); onClose(); } }}>"
      },
      {
        "line": 15,
        "text": "      {footer && <div className=\"fw-dialog-actions bw-dialog-actions\">{footer}</div>}"
      },
      {
        "line": 105,
        "text": "  return <PanelDialog title=\"Agent 请求访问其他任务的网页\" subtitle={`当前运行：${request.fromTitle}`} onClose={() => onDecide(null)}"
      },
      {
        "line": 107,
        "text": "    <div className=\"bw-kv\"><span>目标任务</span><strong>{request.targetTitle}</strong><span>所属项目</span><strong>{request.projectName}（与当前任务相同）</strong></div>"
      },
      {
        "line": 112,
        "text": "    <p className=\"bw-hint\"><ShieldAlert size={13} />授权只在本次运行内有效，运行结束、终端退出或你撤销后立即失效；跨项目请求一律拒绝。两个任务共用同一项目登录态。</p>"
      },
      {
        "line": 117,
        "text": "  return <PanelDialog title=\"跨任务授权\" subtitle=\"本次运行中你已允许的访问\" onClose={onClose} footer={<button type=\"button\" onClick={onClose}>完成</button>}>"
      },

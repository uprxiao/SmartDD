 stage='long-page';await ui.click('[data-testid=task-new-browser]');await app.waitFor('Boolean(document.querySelector(".bw-launcher"))',10000);r.url=siteURL+longSuffix;r.expectedTitle=longTitle;await ui.insert('[aria-label=网页地址]',r.url);await ui.press('Enter');r.page=await poll(async()=>{const s=await app.invoke('browser.snapshot',{taskId:r.taskId});return s.tabs.find(t=>t.id===s.activeId&&t.url===r.url&&t.title===longTitle&&!t.loading)});r.nativePageId=await poll(()=>own('return E.webContents.getAllWebContents().find(w=>!w.isDestroyed()&&w.getURL()==='+JSON.stringify(r.url)+')?.id??null;','readonly-t146-own-page-id'));pages.add(r.nativePageId);await capture();
 r.titleGeometry=await app.evaluate('(()=>{const e=document.querySelector(".fw-web-tab [role=tab][aria-selected=true]"),s=e.querySelector("span"),b=s.getBoundingClientRect(),p=e.closest(".fw-tabs").getBoundingClientRect(),c=getComputedStyle(s);return{text:s.textContent,title:e.title,width:s.clientWidth,scrollWidth:s.scrollWidth,textOverflow:c.textOverflow,overflowX:c.overflowX,whiteSpace:c.whiteSpace,bounds:{left:b.left,right:b.right},bar:{left:p.left,right:p.right}}})()');assert.equal(r.titleGeometry.text,longTitle);assert.equal(r.titleGeometry.textOverflow,'ellipsis');assert.equal(r.titleGeometry.overflowX,'hidden');assert(r.titleGeometry.scrollWidth>r.titleGeometry.width);assert(r.titleGeometry.bounds.left>=r.titleGeometry.bar.left&&r.titleGeometry.bounds.right<=r.titleGeometry.bar.right);
 await ui.click('[aria-label=网页地址]');await ui.press('End');r.address=await poll(()=>app.evaluate('(()=>{const e=document.querySelector("[aria-label=网页地址]");return e.value.length>1000&&e.selectionEnd===e.value.length&&e.scrollLeft>0?{value:e.value,selectionStart:e.selectionStart,selectionEnd:e.selectionEnd,scrollLeft:e.scrollLeft,scrollWidth:e.scrollWidth,clientWidth:e.clientWidth}:null})()'));assert.equal(r.address.value,r.url);await picture('current-long-title-address-A.png');
 await own('const s={events:[],hooks:[]};for(const id of['+r.window.mainWC+','+r.nativePageId+']){const w=E.webContents.fromId(id);const fn=(_e,i)=>{if(i.type==="keyDown"&&i.key==="Escape")s.events.push({at:Date.now(),wcId:id,key:"Escape"})};w.on("before-input-event",fn);s.hooks.push({w,fn})}globalThis.__M12T146Human=s;return true;','observe-t146-human-finish-key');await app.evaluate('(()=>{const s={events:[]};s.fn=e=>{const t=e.target instanceof Element&&e.target.closest(".fw-web-tab [role=tab][aria-selected=true]");if(t&&s.events.length<100)s.events.push({at:Date.now(),trusted:e.isTrusted,title:t.title});};document.addEventListener("mousemove",s.fn,true);globalThis.__M12T146Hover=s;return true})()');
 stage='human-hover';await app.invoke('tasks.rename',r.taskId,'将鼠标停在右侧网页标签，看完按 Esc');console.log(JSON.stringify({stage:'human-hover-ready',title:'将鼠标停在右侧上方长标题网页标签；看完按Esc，再回聊天确认',expectedPrefix:'P075 超长网页标题',expectedEnd:'结束'}));r.humanFinish=await poll(()=>own('return globalThis.__M12T146Human.events[0]??null;','readonly-t146-human-finish-key'),240000);r.hoverEvents=await app.evaluate('globalThis.__M12T146Hover.events');r.nativeTooltipImageCaptured=false;r.userObservationPending=true;r.checks.push({id:'current-title-ellipsis-address-scroll',passed:true},{id:'human-finish-Escape',event:r.humanFinish,hoverEvents:r.hoverEvents.length});r.status='executed-unjudged';

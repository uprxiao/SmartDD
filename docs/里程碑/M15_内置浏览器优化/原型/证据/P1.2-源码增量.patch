new file mode 100644
index 000000000..846d14d7d
--- /dev/null
+++ b/prototypes/m6-codex/src/m15.css
@@ -0,0 +1,90 @@
+.m15-demobar {
+  flex-wrap: wrap;
+  gap: 6px 10px;
+}
+
+.m15-demobar label,
+.m15-feedback {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.m15-demobar button,
+.m15-demobar select {
+  min-height: 26px;
+  padding: 3px 8px;
+  color: var(--text);
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 7px;
+}
+
+.m15-demobar button:hover {
+  background: var(--hover);
+}
+
+.m15-area .m14-timeline {
+  gap: 14px;
+}
+
+.m15-feedback {
+  color: var(--secondary);
+}
+
+.m15-result summary {
+  cursor: pointer;
+  overflow-wrap: anywhere;
+}
+
+.m15-result p,
+.m15-bottom .m14-request > p,
+.m15-steps {
+  margin: 8px 0 0;
+}
+
+.m15-bottom .m14-request > p {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--secondary);
+}
+
+.m15-bottom .m14-request + .reference-composer {
+  margin-top: 8px;
+}
+
+.m15-area .m14-request-actions button.primary:hover:not(:disabled) {
+  color: var(--on-primary);
+  background: color-mix(in srgb, var(--primary) 88%, var(--bg));
+}
+
+.m15-steps {
+  padding-inline-start: 22px;
+}
+
+.m15-steps li {
+  padding: 3px 0;
+  overflow-wrap: anywhere;
+}
+
+.m15-steps small {
+  display: block;
+  color: var(--muted);
+}
+
+.m15-address span {
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.m15-address svg {
+  flex-shrink: 0;
+}
+
+.m15-area :is(button, select, summary):focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}

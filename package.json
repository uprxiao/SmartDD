{
  "name": "smartdd",
  "version": "0.0.4",
  "private": true,
  "description": "SmartDD - Mac Desktop AI 开发工作台",
  "homepage": "https://github.com/uprxiao/SmartDD",
  "author": { "name": "SmartDD contributors" },
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-tests.mjs",
    "test:release": "node --test scripts/release/release.test.mjs",
    "release:next": "node scripts/release/version.mjs",
    "release:check": "node scripts/release/metadata.mjs",
    "db:generate": "drizzle-kit generate",
    "rebuild": "electron-rebuild -f --only=better-sqlite3,node-pty",
    "postinstall": "electron-rebuild -f --only=better-sqlite3,node-pty",
    "probe": "electron-vite build && SMARTDD_PROBE=1 electron .",
    "probe:m4:cli": "SMARTDD_M4_CLI_PROBE=1 pnpm test src/main/core/capabilities/cli-smoke.test.ts",
    "probe:m4:ui": "pnpm build && node scripts/m4-ui-smoke.mjs",
    "probe:m5": "node scripts/m5-acceptance.mjs",
    "package": "node scripts/release/build.mjs --dir",
    "package:release": "node scripts/release/build.mjs"
  },
  "dependencies": {
    "@xterm/addon-unicode11": "0.9.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.32.2",
    "mysql2": "^3.24.6",
    "node-pty": "1.1.0",
    "pg": "^8.23.1",
    "smol-toml": "^1.9.1",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.24.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "i18next": "^26.4.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.564.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.16",
    "react-resizable-panels": "^4.14.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty",
      "electron",
      "esbuild"
    ]
  }
}

            },
            "authModeValidation": "不支持的禅道认证方式。"
          },
          "configSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "zentao"
              },
              "baseUrl": {
                "type": "string",
                "maxLength": 2048
              },
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "authMode": {
                "type": "string",
                "enum": [
                  "token",
                  "password"
                ]
              }
            },
            "required": [
              "kind",
              "baseUrl",
              "username",
              "authMode"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
